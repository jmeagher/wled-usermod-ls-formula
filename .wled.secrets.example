# Copy to .wled.secrets (gitignored) and fill in; then `chmod 600 .wled.secrets`.
# Read by board_setup/provision.py. Format: KEY=VALUE, one per line, '#' for comments.

# The home WiFi the board should join. Password: 8-63 characters, or empty for an open network.
WIFI_SSID=my-home-network
WIFI_PASSWORD=change-me-please

# Password of the board's own access point (the one it opens when it cannot join your WiFi).
# 8-63 characters. If omitted, WLED's default "wled1234" stays in effect.
AP_PASSWORD=change-me-too
