# MBR-Door: centre = top of the door frame, leaves fall out to both ends in ~2 s.
# Green: one dot per 10 px, each wandering slowly (~16 s per drift) within its block.
# Leaves: 2-3 px, red/orange/yellow, ~4 per second in total (both sides).
let ct = 2 * i - (n - 1)               # signed offset from the centre, half px
let lw = t / 41 - abs(ct)              # leaf coordinate: 49 half px in ~2 s
let a = hash((lw >> 3) * 2 + (ct > 0)) # one random leaf slot per 8 half px, per side
let b = hash(a + 12345)
let lp = lw & 7                        # position inside the slot
let off = b % 3
let ln = 4 + 2 * (b >> 4 & 1)          # 4 or 6 half px = 2 or 3 px
let gp = 1280 + (noise(i / 10 * 997, t / 64) - 128) * 8   # green dot, 1/256 px
let gi = max(0, 256 - abs(i % 10 * 256 - gp) * 3 / 2)
sel((a & 255) < 166 && lp >= off && lp < off + ln,
  hsv((b >> 8) % 3 * 21, 255, 255),
  hsv(75 + hash(i / 10) % 20, 255, gi * 2 / 5))
