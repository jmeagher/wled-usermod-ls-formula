# 8 sparkles at once on a 256-pixel panel; use as an overlay (blend mode Add).
# 8 interleaved groups (i & 7); each shows one random-pixel sparkle per ~1 s round,
# random yellow / white / pink shade each time. Custom slider 1 above 200 adds red and green.
let g = i & 7
let tt = t + g * 137
let f = (tt & 1023) >> 2
let q = hash(g * 131 + (tt >> 10) * 7 + 17)
let v = min(sin(64 + f / 2), f * 6)
let r = (q >> 5) % sel(c1 > 200, 5, 3)
let sh = q / 96 & 63
let base = sel(r == 0, 30, sel(r == 1, 128, sel(r == 2, 226, sel(r == 3, 250, 82))))
let sat = sel(r == 1, sh / 2, sel(r == 2, 70 + sh * 2, 255 - sh / 2))
sel((q & 31) == (i >> 3), dim(hsv(base + sh / 6, sat, 255), v), 0)
